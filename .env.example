# ==============================================================================
# CodeAlpha E-commerce Store — Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Secrets
# Generate a strong 256-bit secret for production (e.g., openssl rand -hex 32)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_change_in_production

# CORS Configuration (Comma-separated origins)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=15

# Database Path (relative to project root or absolute)
DATABASE_PATH=src/database/ecommerce.db
